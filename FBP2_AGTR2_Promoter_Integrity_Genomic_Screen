    "Myotis_myotis", "Hipposideros_armiger", "Hipposideros_larvatus",
    "Rhinolophus_ferrumequinum", "Rhinolophus_sinicus", "Rhinolophus_hipposideros", "Rhinolophus_affinis",
    "Apus_apus", "Calypte_anna", "Selasphorus_platycercus"
]

# ----------------- PANEL 1: FBP2 CONTROL -----------------
ax1.set_title("FBP2 Promoter Control (Pipeline Sensitivity Validation)", fontsize=11, pad=10)
fbp2_df = df_clean[df_clean["Target_Gene"] == "FBP2"]

for idx, sp in enumerate(species_order):
    sp_data = fbp2_df[fbp2_df["Species_Clean"] == sp]
    for _, row in sp_data.iterrows():
        ax1.barh(idx, row["Alignment_Len"], height=0.4, color=colors[row["Query_Source"]], alpha=0.9)
        ax1.text(row["Alignment_Len"] + 15, idx - 0.1, f"{row['Percent_Identity']:.1f}%", fontsize=9, fontweight='bold', color="#333333")

# ----------------- PANEL 2: AGTR2 ECO-EVO EXPERIMENT -----------------
ax2.set_title("AGTR2 Promoter Retention Matrix", fontsize=11, pad=10)
agtr2_df = df_clean[df_clean["Target_Gene"] == "AGTR2"]

for idx, sp in enumerate(species_order):
    sp_data = agtr2_df[df_clean["Species_Clean"] == sp]
    if sp_data.empty:
        # Explicit text marker for true locus collapse rows
        ax2.text(10, idx - 0.1, "Locus Missing", color="#C0392B", fontsize=9.5, slant="italic", weight="bold")
    for _, row in sp_data.iterrows():
        ax2.barh(idx, row["Alignment_Len"], height=0.4, color=colors[row["Query_Source"]], alpha=0.9)
        ax2.text(row["Alignment_Len"] + 15, idx - 0.1, f"{row['Percent_Identity']:.1f}%", fontsize=9, fontweight='bold', color="#333333")

# Format Axes and Layout Constraints
ax1.set_yticks(range(len(species_order)))
ax1.set_yticklabels([s.replace("_", " ") for s in species_order], fontsize=10, fontweight='bold')
ax1.invert_yaxis()

ax1.set_xlabel("Query Alignment Length (bp)", fontsize=10)
ax2.set_xlabel("Query Alignment Length (bp)", fontsize=10)
ax1.set_xlim(0, 1150)
ax2.set_xlim(0, 1150)

