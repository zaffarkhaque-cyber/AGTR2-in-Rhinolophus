# Setup publication styling parameters
plt.style.use('seaborn-v0_8-whitegrid' if 'seaborn-v0_8-whitegrid' in plt.style.available else 'default')
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6), sharey=True)
fig.suptitle("Promoter Integrity Across Clades: FBP2 Positive Control vs. AGTR2 Loss", fontsize=15, fontweight='bold', y=0.98)

colors = {"Myotis_myotis": "#802A2A", "Apus_apus": "#E67E22"}
