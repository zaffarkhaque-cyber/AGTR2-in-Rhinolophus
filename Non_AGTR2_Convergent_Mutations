#!/usr/bin/env python3
"""Convergent Non-AGTR2 Molecular Adaptation Pipeline.

Supports raw Notepad protein lists (with or without '>' FASTA headers) and
either NCBI Datasets .zip archives or extracted .fna genome assemblies.
Reconstructs spliced orthologs via TBLASTN locus clustering + Exonerate,
aligns sequences with MUSCLE v5, and isolates convergent substitutions shared
across AGTR2-deficient lineages.
"""

import csv
from operator import itemgetter
import os
import re
import subprocess
import zipfile
from Bio import SeqIO
from Bio.Seq import Seq
from Bio.SeqRecord import SeqRecord

# ==============================================================================
# CONFIGURATION
# ==============================================================================
WORK_DIR = "./results"
QUERY_FILE = "./data/AGTR1_RASS_Analysis_Protein_Sequences.txt"
GENOME_INPUT_DIR = "./data/genomes"  # Accepts .zip archives or .fna files

RHINOLOPHUS_NON_AGTR2 = {
    "Rhinolophus_sinicus",
    "Rhinolophus_ferrumequinum",
    "Rhinolophus_hipposideros",
}

AVIAN_NON_AGTR2 = "Calypte_anna"

CANDIDATE_NON_AGTR2 = {
    "Hipposideros_armiger",
    "Hipposideros_larvatus",
}

AGTR2_INTACT_CONTROLS = {
    "Homo_sapiens",
    "Myotis_myotis",
    "Rousettus_aegyptiacus",
    "Acinonyx_jubatus",
    "Apus_apus",
    "Trichoglossus_moluccanus",
}

TBLASTN_EVALUE = "1e-3"
CLUSTER_WINDOW_BP = 500000
FLANK_BP = 25000
MIN_RHINOLOPHUS_HITS = 2
MAX_CONTROL_LEAKAGE = 0


def parse_flexible_sequences(seq_path):
  """Parses plain Notepad protein lists (with or without '>' FASTA headers)."""
  records = []
  current_header = None
  current_seq = []

  with open(seq_path, "r", encoding="utf-8", errors="ignore") as f:
    for line in f:
      line = line.strip()
      if not line:
        continue
      if re.fullmatch(r"[ACDEFGHIKLMNPQRSTVWY]+", line):
        current_seq.append(line)
      else:
        if current_header and current_seq:
          clean_id = re.sub(r"[^A-Za-z0-9_=-]", "_", current_header)[:35]
          records.append(
              SeqRecord(
                  Seq("".join(current_seq)),
                  id=clean_id,
                  description=current_header,
              )
          )
        current_header = line.lstrip(">").strip()
        current_seq = []

  if current_header and current_seq:
    clean_id = re.sub(r"[^A-Za-z0-9_=-]", "_", current_header)[:35]
    records.append(
        SeqRecord(
            Seq("".join(current_seq)), id=clean_id, description=current_header
        )
    )
  return records


def prepare_genomes(input_dir, extract_dir, allowed_species):
  """Maps .fna files directly or extracts genomic .fna files from NCBI .zip archives."""
  os.makedirs(extract_dir, exist_ok=True)
  genome_map = {}

  for fname in os.listdir(input_dir):
    full_path = os.path.join(input_dir, fname)
    matched_sp = next(
        (sp for sp in allowed_species if sp.lower() in fname.lower()), None
    )
    if not matched_sp:
      continue

    if fname.endswith(".fna"):
      genome_map[matched_sp] = full_path
    elif fname.endswith(".zip"):
      out_fna = os.path.join(extract_dir, f"{matched_sp}.fna")
      if not os.path.exists(out_fna) or os.path.getsize(out_fna) == 0:
        with zipfile.ZipFile(full_path, "r") as z:
          fna_members = [m for m in z.namelist() if m.endswith(".fna")]
          if fna_members:
            with z.open(next(iter(fna_members))) as src, open(
                out_fna, "wb"
            ) as dst:
              while True:
                chunk = src.read(1024 * 1024 * 10)
                if not chunk:
                  break
                dst.write(chunk)
      if os.path.exists(out_fna):
        genome_map[matched_sp] = out_fna

  return genome_map


def locate_and_extract_locus(query_faa, genome_fna, out_locus_fna):
  """Finds the top 500 kb genomic cluster via TBLASTN and extracts it with flanks."""
  cmd = [
      "tblastn",
      "-query",
      query_faa,
      "-subject",
      genome_fna,
      "-evalue",
      TBLASTN_EVALUE,
      "-seg",
      "no",
      "-outfmt",
      "6 sseqid sstart send bitscore",
  ]
  res = subprocess.run(cmd, capture_output=True, text=True, check=True)
  lines = res.stdout.strip().splitlines()
  if not lines:
    return None

  hits = []
  for line in lines:
    scaff, s1_str, s2_str, score_str = line.split("\t")
    s1, s2 = int(s1_str), int(s2_str)
    hits.append((scaff, min(s1, s2), max(s1, s2), float(score_str)))

  hits.sort(key=itemgetter(0, 1))

  clusters = []
  for scaff, h_start, h_end, h_score in hits:
    placed = False
    for c in clusters:
      if scaff == c["scaff"] and (h_start - c["end"]) <= CLUSTER_WINDOW_BP:
        c["start"] = min(c["start"], h_start)
        c["end"] = max(c["end"], h_end)
        c["score"] += h_score
        placed = True
        break
    if not placed:
      clusters.append(
          {"scaff": scaff, "start": h_start, "end": h_end, "score": h_score}
      )

  best_cluster = max(clusters, key=itemgetter("score"))
  win_start = max(0, best_cluster["start"] - FLANK_BP)
  win_end = best_cluster["end"] + FLANK_BP

  for rec in SeqIO.parse(genome_fna, "fasta"):
    if rec.id == best_cluster["scaff"]:
      sub_seq = rec.seq[win_start:win_end]
      SeqIO.write(
          SeqRecord(sub_seq, id=rec.id, description=""), out_locus_fna, "fasta"
      )
      return best_cluster["scaff"]

  return None


def reconstruct_protein_exonerate(query_faa, locus_fna):
  """Reconstructs spliced coding sequence using Exonerate protein2genome."""
  cmd = [
      "exonerate",
      "--model",
      "protein2genome",
      "--bestn",
      "1",
      "--showalignment",
      "no",
      "--showvulgar",
      "no",
      "--ryo",
      ">%ti\\n%tcs\\n",
      query_faa,
      locus_fna,
  ]
  res = subprocess.run(cmd, capture_output=True, text=True, check=True)
  lines = res.stdout.strip().splitlines()

  cds_lines = [
      l.strip()
      for l in lines
      if l.strip() and re.fullmatch(r"[ACGTNacgtn]+", l.strip())
  ]
  if not cds_lines:
    return ""

  raw_dna = "".join(cds_lines)
  trim_len = len(raw_dna) - (len(raw_dna) % 3)
  return str(Seq(raw_dna[:trim_len]).translate(to_stop=True))


def scan_convergent_mutations(msa_fasta, gene_name, csv_writer):
  """Scans a MUSCLE MSA and writes convergent non-AGTR2 substitutions to CSV."""
  records = list(SeqIO.parse(msa_fasta, "fasta"))
  ref = next((r for r in records if r.id == "REFERENCE_HUMAN_QUERY"), None)
  if not ref:
    return

  others = {r.id: r.seq for r in records if r.id != "REFERENCE_HUMAN_QUERY"}
  hs_seq = others.get("Homo_sapiens")

  human_pos = 0
  for col in range(len(ref.seq)):
    h_aa = ref.seq[col]
    if h_aa == "-":
      continue
    human_pos += 1

    if hs_seq and hs_seq[col] != h_aa:
      continue

    if AVIAN_NON_AGTR2 not in others or others[AVIAN_NON_AGTR2][col] in (
        "-",
        h_aa,
    ):
      continue
    target_aa = others[AVIAN_NON_AGTR2][col]

    ctrl_matches = [
        c
        for c in AGTR2_INTACT_CONTROLS
        if c in others and others[c][col] == target_aa
    ]
    if len(ctrl_matches) > MAX_CONTROL_LEAKAGE:
      continue

    rhino_hits = sorted([
        b
        for b in RHINOLOPHUS_NON_AGTR2
        if b in others and others[b][col] == target_aa
    ])
    hippo_hits = sorted([
        b
        for b in CANDIDATE_NON_AGTR2
        if b in others and others[b][col] == target_aa
    ])

    if len(rhino_hits) >= MIN_RHINOLOPHUS_HITS:
      all_carriers = [AVIAN_NON_AGTR2] + rhino_hits + hippo_hits
      ctrl_summary = " | ".join(
          f"{c}:{others[c][col]}"
          for c in sorted(AGTR2_INTACT_CONTROLS)
          if c in others and others[c][col] != "-"
      )
      csv_writer.writerow([
          gene_name,
          human_pos,
          h_aa,
          target_aa,
          f"{len(rhino_hits)} of {len(RHINOLOPHUS_NON_AGTR2)}",
          "YES",
          f"{len(hippo_hits)} of {len(CANDIDATE_NON_AGTR2)}",
          " | ".join(all_carriers),
          ctrl_summary,
      ])


def main():
  msa_dir = os.path.join(WORK_DIR, "multispecies_MSAs")
  extract_dir = os.path.join(WORK_DIR, "extracted_genomes")
  os.makedirs(msa_dir, exist_ok=True)

  temp_q = os.path.join(WORK_DIR, "temp_query.faa")
  temp_locus = os.path.join(WORK_DIR, "temp_locus.fna")
  out_csv = os.path.join(WORK_DIR, "Convergent_Non_AGTR2_Adaptations.csv")

  allowed_species = (
      RHINOLOPHUS_NON_AGTR2
      | {AVIAN_NON_AGTR2}
      | CANDIDATE_NON_AGTR2
      | AGTR2_INTACT_CONTROLS
  )

  queries = parse_flexible_sequences(QUERY_FILE)
  genomes = prepare_genomes(GENOME_INPUT_DIR, extract_dir, allowed_species)
  print(f"Loaded {len(queries)} query proteins and {len(genomes)} genomes.")

  with open(out_csv, "w", newline="") as f:
    writer = csv.writer(f)
    writer.writerow([
        "Gene",
        "Human_Pos",
        "Human_AA",
        "Shared_Non_AGTR2_AA",
        "Rhinolophus_Count",
        "Hummingbird_Match",
        "Hipposideros_Count",
        "Carriers",
        "Control_Species_AA",
    ])

    for query in queries:
      print(f"\nProcessing {query.id}...")
      SeqIO.write(query, temp_q, "fasta")
      reconstructed = [
          SeqRecord(query.seq, id="REFERENCE_HUMAN_QUERY", description="")
      ]

      for sp_name, fna_path in sorted(genomes.items()):
        scaff = locate_and_extract_locus(temp_q, fna_path, temp_locus)
        if not scaff:
          continue
        prot_seq = reconstruct_protein_exonerate(temp_q, temp_locus)
        if len(prot_seq) > 20:
          reconstructed.append(
              SeqRecord(Seq(prot_seq), id=sp_name, description="")
          )
          print(
              f"  [{sp_name}] {len(prot_seq)}/{len(query.seq)} aa ({scaff})"
          )

      if len(reconstructed) < 3:
        continue

      unaligned_faa = os.path.join(msa_dir, f"{query.id}_unaligned.faa")
      aligned_faa = os.path.join(msa_dir, f"{query.id}_MSA.fasta")
