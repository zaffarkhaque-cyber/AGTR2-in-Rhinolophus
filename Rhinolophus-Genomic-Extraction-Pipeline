python"""
Title: Automated Multi-Locus Transcriptomic Screening and Genomic Extraction Pipeline
Author: Shazia Group / Publication Workspace
Description: This script parses Ensembl cDNA archives to validate multi-species expression 
             and carves structural loci from raw primary assemblies based on alignment boundaries.
"""

import gzip
import os
import pandas as pd
from Bio import SeqIO

# --- CONFIGURATION PARAMETERS ---
CDNA_FILE = "mRhiFer1_v1.p.cdna.all.fa.gz"
GENOME_FILE = "bat_genome.fna"
BLAST_RESULTS = "final_blast_results.txt"
OUTPUT_FASTA = "extracted_bat_genes.fasta"
E_VALUE_THRESHOLD = 1e-5

# Targeted Multi-Locus Query Matrix (HGNC symbols and known mammalian synonyms)
TARGET_MATRIX = {
    "AOPEP": ["AOPEP"],
    "FBP1": ["FBP1"],
    "FBP2": ["FBP2"],
    "PLS3": ["PLS3"],
    "SLC6A14": ["SLC6A14"],
    "SLC71A2": ["SLC71A2", "MFSD14B", "HIATL1", "MFSD148"],
    "SSXA1": ["SSXA1", "SSX"],
    "AGTR2": ["AGTR2"]
}

def run_phase_1_transcript_screen():
    print(f"\n[PHASE 1] Initializing in silico screening against transcriptome library: {CDNA_FILE}...")
    if not os.path.exists(CDNA_FILE):
        print(f"  CRITICAL ERROR: Archive file '{CDNA_FILE}' not found in current directory.")
        return False
        
    expression_results = {gene: "None Detected" for gene in TARGET_MATRIX}
    total_transcripts = 0

    with gzip.open(CDNA_FILE, "rt") as handle:
        for record in SeqIO.parse(handle, "fasta"):
            total_transcripts += 1
            header_text = record.description.lower()
            transcript_id = record.id
            
            for gene, synonyms in TARGET_MATRIX.items():
                for synonym in synonyms:
                    if f"gene:{synonym.lower()}" in header_text or f"gene_symbol:{synonym.lower()}" in header_text:
                        expression_results[gene] = f"{transcript_id} (+ve)"

    print(f"  Screening complete. Processed {total_transcripts:,} raw transcripts.")
    print(f"\n  {'Gene Symbol':<15} {'Expression Status / Ensembl Stable ID'}")
    print(f"  " + "-" * 55)
    for gene, status in expression_results.items():
        print(f"  {gene:<15} {status}")
    return True

def run_phase_2_genomic_extraction():
    print(f"\n[PHASE 2] Parsing structural boundaries from alignment file: {BLAST_RESULTS}...")
    if not os.path.exists(BLAST_RESULTS) or not os.path.exists(GENOME_FILE):
        print(f"  CRITICAL ERROR: Missing baseline files '{BLAST_RESULTS}' or '{GENOME_FILE}'.")
        return False

    columns = ["qseqid", "sseqid", "pident", "length", "mismatch", "gapopen", "qstart", "qend", "sstart", "send", "evalue", "bitscore"]
    df = pd.read_csv(BLAST_RESULTS, sep="\t", names=columns)
    
    # Filter by statistical stringency and clean strand boundaries
    df = df[df["evalue"] < E_VALUE_THRESHOLD]
    df["start_clean"] = df[["sstart", "send"]].min(axis=1)
    df["end_clean"] = df[["sstart", "send"]].max(axis=1)

    grouped = df.groupby(["qseqid", "sseqid"]).agg({"start_clean": "min", "end_clean": "max"}).reset_index()
    
    regions = {}
    for idx, row in grouped.iterrows():
        chrom = row["sseqid"]
        if chrom not in regions: regions[chrom] = []
        regions[chrom].append({"gene": row["qseqid"], "start": int(row["start_clean"]), "end": int(row["end_clean"])})

    print(f"  Indexed {len(grouped)} structural loci. Slice-extracting bases from: {GENOME_FILE}...")
    current_chrom, chrom_seq, extracted_count = None, [], 0

    with open(OUTPUT_FASTA, "w") as out_fasta:
        def process_chrom_block(chrom_id, seq_list):
            nonlocal extracted_count
            if not chrom_id or chrom_id not in regions: return
            full_seq = "".join(seq_list)
            for target in regions[chrom_id]:
                sub_seq = full_seq[max(0, target["start"] - 1):min(len(full_seq), target["end"])]
                out_fasta.write(f">{target['gene']}_{chrom_id}_{target['start']}-{target['end']}\n")
                for i in range(0, len(sub_seq), 80):
                    out_fasta.write(sub_seq[i:i+80] + "\n")
                out_fasta.write("\n")
                extracted_count += 1

        with open(GENOME_FILE, "r") as f:
            for line in f:
                if line.startswith(">"):
                    if current_chrom: process_chrom_block(current_chrom, chrom_seq)
                    current_chrom = line.split()[0].replace(">", "")
                    chrom_seq = []
                else:
                    chrom_seq.append(line.strip())
            if current_chrom: process_chrom_block(current_chrom, chrom_seq)

    print(f"  Success! Exported {extracted_count} sequence blocks into: {OUTPUT_FASTA}")

if __name__ == "__main__":
    print("=" * 60)
    print("      GENOMIC AND TRANSCRIPTOMIC DATA PROCESSING PIPELINE")
    print("=" * 60)
    p1_success = run_phase_1_transcript_screen()
    if p1_success:
        run_phase_2_genomic_extraction()
    print("\n" + "=" * 60)
