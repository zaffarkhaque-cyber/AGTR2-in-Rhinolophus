def fetch_ncbi_hit_count(species, gene_aliases):
    """Constructs clean Boolean search queries and probes NCBI counts."""
    query_parts = [f'("{species}"[Organism] AND "{alias}"[Gene Symbol])' for alias in gene_aliases]
    boolean_query = " OR ".join(query_parts)
    
    total_hits = 0
    # Probe both the nucleotide and protein repositories
    for database in ["nuccore", "protein"]:
        try:
            handle = Entrez.esearch(db=database, term=boolean_query, rettype="count")
            record = Entrez.read(handle)
            handle.close()
            total_hits += int(record["Count"])
            time.sleep(0.45)  # Mandatory server safety interval
        except Exception:
            return "ERROR"
            
    return total_hits

def main():
    print("================================================================")
    print(f"[START] Launching cross-species automated screen for {len(SPECIES_LIST)} taxa...")
    print("================================================================\n")
    
    # Establish headers with unique names to match your spreadsheet file exactly
    headers = ["Species"] + list(GENE_DICT.keys()) + ["Species_End_Index"]
    
    with open(OUTPUT_FILE, "w", newline="", encoding="utf-8") as csvfile:
        writer = csv.writer(csvfile)
        writer.writerow(headers)
        
        for species in SPECIES_LIST:
            print(f"Polling database counts for: {species}...")
            row_data = [species]
            
            for gene, aliases in GENE_DICT.items():
                count = fetch_ncbi_hit_count(species, aliases)
                
                if count == "ERROR":
                    row_data.append("ERROR")
                elif count > 0:
                    row_data.append(f"+ve ({count})")
                else:
                    row_data.append("-ve (0)")
                    
            row_data.append(species)  # Fills trailing end index column safely
            writer.writerow(row_data)
            print(f" -> Row entries successfully mapped for {species}.\n")
            
    print(f"\n[COMPLETE] Multi-locus matrix integrated into '{OUTPUT_FILE}'.")

if __name__ == "__main__":
    main()
