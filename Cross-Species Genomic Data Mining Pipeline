cat << 'EOF' > master_ortholog_miner.py
#!/usr/bin/env python3
import os
import time
import sys
from Bio import Entrez

# 1. NCBI API ACCOUNTHandshake REGISTRATION
Entrez.email = "your.email@example.com"  # Register your active email with the servers
Entrez.tool = "CrossSpeciesOrthologMiner"

# 2. THE COMPREHENSIVE TAXONOMIC ARRAY 
SPECIES_LIST = [
    "Megaderma spasma",  "Plecotus auritus", 
    "Rhinolophus ferrumequinum", "Rhinolophus hipposideros", "Rhinolophus sinicus",
    "Rhinolophus affinis",   
    "Molossus molossus",  "Myotis myotis",
    "Hipposideros larvatus", "Hipposideros armiger", "Homo sapiens", "Lichenostomus cassidix",
     "Calypte anna", "Heliangelus exortis"
]

# 3. COMPLETE LOCI DIRECTORY 
GENE_DICT = {
    'AGTR1': ['"AGTR1"[Gene Symbol]', '"AT1R"[Gene Symbol]', '"angiotensin II receptor type 1"[Protein Name]'],
    'AGTR2': ['"AGTR2"[Gene Symbol]', '"angiotensin II receptor type 2"[Protein Name]'],
    'PLS3': ['"PLS3"[Gene Symbol]', '"plastin-3"[Protein Name]'],
    'SLC6A14': ['"SLC6A14"[Gene Symbol]', '"sodium- and chloride-dependent neurotransmitter transporter alpha-like"[Protein Name]'],
    'FBP1': ['"FBP1"[Gene Symbol]', '"fructose-1,6-bisphosphatase 1"[Protein Name]', '"fructose-1,6-bisphosphatase 1-like"[Protein Name]'],
    'FBP2': ['"FBP2"[Gene Symbol]', '"fructose-1,6-bisphosphatase 2"[Protein Name]', '"fructose-1,6-bisphosphatase 2-like"[Protein Name]'],
    'PYHIN1': ['"PYHIN1"[Gene Symbol]', '"pyrin domain containing 1"[Protein Name]', '"pyrin domain-containing protein 1-like"[Protein Name]']
}

def scan_ncbi_live_count(species, search_terms):
    """Executes explicit cross-referencing queries across live server repositories."""
    query_parts = [f'("{species}"[Organism] AND {term})' for term in search_terms]
    boolean_query = " OR ".join(query_parts)
    
    total_hits = 0
    for database in ["nuccore", "protein"]:
        try:
            handle = Entrez.esearch(db=database, term=boolean_query, rettype="count")
            record = Entrez.read(handle)
            handle.close()
            total_hits += int(record["Count"])
            time.sleep(0.35)  # Strict network delay loop configuration to preserve link stability
        except Exception:
            return 0
    return 1 if total_hits > 0 else 0

def main():
    print("=================================================================")
    print("=== [START] LAUNCHING COMPREHENSIVE LIVE GENOMIC MATRIX SCAN  ===")
    print("=================================================================\n")
    
    # Establish generic headers matching your workbook schema configuration
    header = "Species\t" + "\t".join(GENE_DICT.keys())
    print(header)
    print("-" * 140)
    
    # Iterate across the full species cohort block
    for species in SPECIES_LIST:
        row_entries = [species]
        for gene, terms in GENE_DICT.items():
            state = scan_ncbi_live_count(species, terms)
            row_entries.append(str(state))
            
        print("\t".join(row_entries))
        sys.stdout.flush() # Flush text characters continuously to prevent pipeline terminal freeze
        
    print("\n=================================================================")
    print("=== [COMPLETE] Full Dataset Mining Run Finished Natively     ===")
    print("=================================================================")

if __name__ == "__main__":
    main()
EOF
