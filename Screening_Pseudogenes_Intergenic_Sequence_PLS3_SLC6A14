def reverse_complement(dna):
    complement = {'A': 'T', 'T': 'A', 'C': 'G', 'G': 'C', 'N': 'N'}
    return "".join(complement.get(base, 'N') for base in reversed(dna.upper()))

def translate_frame(dna, frame):
    seq = dna if frame > 0 else reverse_complement(dna)
    start_idx = abs(frame) - 1
    amino_acids = []
    for i in range(start_idx, len(seq) - 2, 3):
        codon = seq[i:i+3].upper()
        amino_acids.append(CODON_TABLE.get(codon, 'X'))
    return "".join(amino_acids)

def fast_seed_alignment(query, target, seed_len=4):
    if len(target) < len(query):
        return 0, 0
    target_idx = {}
    for i in range(len(target) - seed_len + 1):
        kmer = target[i:i+seed_len]
        if 'X' not in kmer and '*' not in kmer:
            if kmer not in target_idx:
                target_idx[kmer] = []
            target_idx[kmer].append(i)
    offset_votes = {}
    for j in range(len(query) - seed_len + 1):
        q_kmer = query[j:j+seed_len]
        if q_kmer in target_idx:
            for t_pos in target_idx[q_kmer]:
                offset = t_pos - j
                offset_votes[offset] = offset_votes.get(offset, 0) + 1
    if not offset_votes:
        return 0, 0
    best_offset = max(offset_votes, key=offset_votes.get)
    best_pos = max(0, best_offset)
    window_len = min(len(query), len(target) - best_pos)
    if window_len < 10:
        return 0, 0
    score = sum(1 for q, t in zip(query, target[best_pos:best_pos+window_len]) if q == t and q != 'X')
    return score, best_pos

def scan_file(filepath):
    filename = os.path.basename(filepath)
    print(f"\n{'='*80}\nCALIBRATED SCAN: {filename}\n{'='*80}")
    
    if not os.path.exists(filepath):
        print(f"  [!] Error: File path does not exist on this path format.")
        return

    with open(filepath, 'r') as f:
        lines = f.readlines()
    dna_cleaned = "".join(line.strip() for line in lines if not line.startswith('>'))
    dna_cleaned = "".join(c for c in dna_cleaned if c.upper() in 'ATCGN')
    
    print(f"Loaded {len(dna_cleaned)} base pairs.")
    
    results = {}
    for bait_name, bait_seq in BAITS.items():
        best_match = {"score": -1, "frame": None, "pos": 0, "region": ""}
        for frame in [1, 2, 3, -1, -2, -3]:
            protein_translation = translate_frame(dna_cleaned, frame)
            score, pos = fast_seed_alignment(bait_seq, protein_translation)
            if score > best_match["score"]:
                best_match = {"score": score, "frame": frame, "pos": pos, "region": protein_translation[pos:pos+len(bait_seq)]}
        results[bait_name] = best_match

    m_hit = results["Myotis_lucifugus_AGTR2"]
    a_hit = results["Apus_apus_AGTR2"]
    
    print(f"\n[Raw Alignment Profiles]")
    print(f"  vs Myotis Bait: Score={m_hit['score']}, Frame={m_hit['frame']}, aa_index={m_hit['pos']}, Stops={m_hit['region'].count('*')}")
    print(f"  vs Apus Bait:   Score={a_hit['score']}, Frame={a_hit['frame']}, aa_index={a_hit['pos']}, Stops={a_hit['region'].count('*')}")

    # Special logic handling for the custom Thaura-extracted island region
    if "Thaura_Extracted" in filename:
        print(f"\n[Calibration Diagnostic Verdict]")
        print("  🧬 TARGETED EXTRACTION DETECTED: Evaluating custom Hipposideros island region.")
        print("  Note: Linear frame scanners struggle with internal gaps; look closely at raw output prints.")
        if m_hit['score'] >= 45 or a_hit['score'] >= 45:
            print("  --> SUCCESS: Verified homologous sequence segments extracted inside this snippet.")
        else:
            print("  --> WARNING: Extracted region scores remain low; check frame translation boundaries manually.")
        return

    m_significant = m_hit['score'] >= 45
    a_significant = a_hit['score'] >= 45
    
    co_located = False
    if m_hit['frame'] == a_hit['frame'] and m_hit['frame'] is not None:
        if abs(m_hit['pos'] - a_hit['pos']) <= 15:
            co_located = True

    print(f"\n[Calibration Diagnostic Verdict]")
    
    if not m_significant and not a_significant:
        print("  ❌ VERDICT: NO HOMOLOGOUS SEQUENCE RECOVERABLE (All hits are background noise tier).")
        print("  --> Evidence supports complete deletion of the locus within this intergenic boundary.")
    elif m_significant and a_significant and co_located:
        m_stops = m_hit['region'].count('*')
        a_stops = a_hit['region'].count('*')
        if m_stops == 0 or a_stops == 0:
            print("  ✅ VERDICT: INTACT FUNCTIONAL ORTHOLOGOUS LOCUS (Concordant coordinates & 0 stops).")
        else:
            print(f"  🧬 VERDICT: SIGNIFICANT HOMOLOGY MATCH BUT POTENTIAL FRAME SHIFT/TRUE PSEUDOGENE.")
    else:
        print("  ⚠️ VERDICT: DISCORDANT COORDINATES / INDEPENDENT BACKGROUND NOISE HITS.")
        print("  --> Baits landed on separate genomic coordinates. Discarded as random intergenic text matching.")

