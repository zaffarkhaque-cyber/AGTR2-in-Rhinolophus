import numpy as np

def verify_math(label, counts):
    obs = np.array(counts)
    N = obs.sum()
    k = len(obs)
    expected = np.full(k, N / k)
    
    # Standard Chi-Square Goodness-of-Fit formula: sum((O - E)^2 / E)
    chi2 = np.sum((obs - expected) ** 2 / expected)
    
    # 1D Cramér’s V for Goodness-of-Fit: sqrt( Chi2 / (N * (k - 1)) )
    v_stat = np.sqrt(chi2 / (N * (k - 1)))
    
    # Modal frame percentage calculation
    modal_share = (obs.max() / N) * 100
    
    print(f"{label:<30} | N = {N:<4} | Chi2 = {chi2:<6.2f} | Cramér\u0027s V = {v_stat:<4.2f} | Modal = {modal_share:.1f}%")

