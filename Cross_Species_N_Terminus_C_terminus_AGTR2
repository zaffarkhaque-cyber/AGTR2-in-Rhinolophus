# 1. Load raw screening data matrix
df = pd.read_csv(input_file, sep="\t")
df.replace(r'^\s*$', pd.NA, regex=True, inplace=True)
df['Identity%'] = pd.to_numeric(df['Identity%']).fillna(0)

# 2. Clean Taxonomy Mapping Function
def clean_taxonomy(path):
    path_lower = path.lower()
    if "roundleaf_genome" in path_lower or "hipposideros_armiger" in path_lower:
        return "Hipposideros armiger"
    elif "larvatus" in path_lower:
        return "Hipposideros larvatus"
    elif "hipposideros" in path_lower:
        return "Rhinolophus hipposideros"
    elif "affinis" in path_lower:
        return "Rhinolophus affinis"
    elif "sinicus" in path_lower:
        return "Rhinolophus sinicus"
    elif "ferrumequinum" in path_lower:
        return "Rhinolophus ferrumequinum"
    elif "megaderma" in path_lower or "spasma" in path_lower:
        return "Megaderma spasma"
    elif "homo_sapiens" in path_lower or "sapiens" in path_lower:
        return "Homo sapiens"
    elif "heliangelus" in path_lower or "exortis" in path_lower:
        return "Heliangelus exortis"
    
    base = os.path.basename(path)
    match = re.search(r"([A-Z][a-z]+_[a-z]+)", base)
    if match:
        return match.group(1).replace("_", " ")
    return "Unknown Variant Species"

df['Taxon'] = df['Genome_Path'].apply(clean_taxonomy)
