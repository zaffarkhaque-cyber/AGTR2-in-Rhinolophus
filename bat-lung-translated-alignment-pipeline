#!/usr/bin/env bash
set -eo pipefail

# ==============================================================================
#  Translated Cross-Species Alignment Pipeline for Bat Lung Transcriptomics
# ==============================================================================

# Hardware and significance constraints
THREADS="$(nproc)"
EVALUE="1e-5"
MATRIX="BLOSUM62"

# File path configurations
PROTEIN_FASTA="target_proteins.fasta"
DB_NAME="bat_target_db"
OUTPUT_TAB="lung_atlas_blast_hits.tsv"

# Direct HTTP sequencing data archive mirror node (BioProject: CNP0002166)
URL="https://cngb.org"

echo "=== [STAGE 1/4] Compiling Target Protein Database ==="
if [ ! -f "$PROTEIN_FASTA" ]; then
    echo "❌ Error: Reference file '$PROTEIN_FASTA' is missing!"
    exit 1
fi
makeblastdb -in "$PROTEIN_FASTA" -dbtype prot -out "$DB_NAME"

echo "=== [STAGE 2 & 3/4] Streaming, Safe Unzipping & Boundary Truncation ==="
if [ -f "subset_reads.fastq" ] && [ -s "subset_reads.fastq" ]; then
    echo "ℹ️ Local data subset found. Skipping network stream."
else
    echo "📥 Processing network data stream up to 4,000,000 sequence rows..."
    # -A browser emulator flag forces the remote server storage node to accept the command pipe
    curl -sL -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64)" "$URL" | zcat -f | head -n 4000000 > subset_reads.fastq
fi

echo "🔄 Converting sequence tracks into clean FASTA layout format..."
awk 'NR%4==1{printf ">%s\n", substr($0,2)} NR%4==2{print}' subset_reads.fastq > subset_reads.fasta

echo "=== [STAGE 4/4] Computing Six-Frame Translated blastx Alignment ==="
echo "💻 Mapping nucleotide matrix spaces natively utilizing $THREADS threads..."
blastx \
    -query subset_reads.fasta \
    -db "$DB_NAME" \
    -matrix "$MATRIX" \
    -evalue "$EVALUE" \
    -outfmt "6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore" \
    -num_threads "$THREADS" > "$OUTPUT_TAB"

echo "=== [FINAL REPORT] Generating Cross-Species Expression Profile ==="
echo -e "Gene_Target\tHit_Count\tAvg_Identity%"
echo -e "-----------\t---------\t-------------"

awk -F'\t' '
    {
        count[$2]++;
        sum_id[$2]+=$3;
    }
    END {
        for (gene in count) {
            printf "%s\t%d\t%.2f%%\n", gene, count[gene], (sum_id[gene]/count[gene])
        }
    }
' "$OUTPUT_TAB" | sort -rn -k2
