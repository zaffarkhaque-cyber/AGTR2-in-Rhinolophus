#!/usr/bin/env bash
# ==============================================================================
# Pipeline: Translated Cross-Species Alignment for Unannotated Transcriptomics
# Author: shazia @ ZaffarHaque
# Repository: Bat-Lung-Transcriptomics-Pipeline
# License: MIT
# ==============================================================================

set -eo pipefail

# --- [CONFIGURATION PANEL] ----------------------------------------------------
THREADS="$(nproc)"                      # Dynamically scale to all available CPU cores
EVALUE="1e-5"                           # Nature/Science peer-review stringency cutoff
MATRIX="BLOSUM62"                       # Standard amino acid substitution matrix
READ_LIMIT="4000000"                    # 4M lines = 1,000,000 deep FASTQ reads

# Data Sources and Reference Paths
PROTEIN_FASTA="target_proteins.fasta"
DB_NAME="bat_target_db"
OUTPUT_TAB="lung_atlas_blast_hits.tsv"
SUMMARY_TSV="bat_lung_expression_summary.tsv"

# Validated CNGB Data Storage Archive Nodes (BioProject: CNP0002166)
URL_HTTP="https://cngb.org"
URL_FTP="ftp://ftp.cngb.org/pub/CNSA/data2/CNP0002166/CNS0418238/CNX0345370/CNR0425223/YX276-YX276-1_L4_1.fq.gz"
# ------------------------------------------------------------------------------

echo "=== [STAGE 1/4] Compiling Target Protein Reference Database ==="
if [ ! -f "$PROTEIN_FASTA" ]; then
    echo "❌ Error: Required reference file '$PROTEIN_FASTA' is missing!"
    echo "Please ensure your protein sequences are formatted in this directory."
    exit 1
fi
makeblastdb -in "$PROTEIN_FASTA" -dbtype prot -out "$DB_NAME"

echo "=== [STAGE 2 & 3/4] Streaming, Decompression & Boundary Truncation ==="
if [ -f "subset_reads.fastq" ] && [ -s "subset_reads.fastq" ]; then
    echo "ℹ️ Valid local raw dataset cache detected. Skipping network download."
else
    echo "📥 Initializing streaming architecture from remote genomic archive..."
    # Fallback Loop: Tries optimized HTTP browser emulation first, drops to native FTP if blocked
    if curl -sL -f -A "Mozilla/5.0" "$URL_HTTP" | zcat -f | head -n "$READ_LIMIT" > subset_reads.fastq; then
        echo "✅ HTTP Stream connection successful."
    elif wget -qO- "$URL_FTP" | zcat -f | head -n "$READ_LIMIT" > subset_reads.fastq; then
        echo "✅ FTP Backup Stream connection successful."
    else
        echo "❌ Error: Network connections rejected by data archive. Check firewall ports 21/443."
        exit 1
    fi
fi

echo "🔄 Converting nucleotide raw space into linear search FASTA..."
awk 'NR%4==1{printf ">%s\n", substr($0,2)} NR%4==2{print}' subset_reads.fastq > subset_reads.fasta

echo "=== [STAGE 4/4] Computing Six-Frame Translated blastx Alignment ==="
echo "💻 Processing alignment matrices natively utilizing $THREADS threads..."
blastx \
    -query subset_reads.fasta \
    -db "$DB_NAME" \
    -matrix "$MATRIX" \
    -evalue "$EVALUE" \
    -outfmt "6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore" \
    -num_threads "$THREADS" > "$OUTPUT_TAB"

echo "=== [FINAL REPORT] Generating Cross-Species Expression Profile ==="
echo -e "Gene_Target\tHit_Count\tAvg_Identity%"
echo -e "-----------\t---------\t-------------"

# Parse Tabular Data and output both to screen and results folder
awk -F'\t' '
    {
        count[$2]++;
        sum_id[$2]+=$3;
    }
    END {
        for (gene in count) {
            printf "%s\t%d\t%.2f%%\n", gene, count[gene], (sum_id[gene]/count[gene])
        }
    }
' "$OUTPUT_TAB" | sort -rn -k2 | tee ../results/"$SUMMARY_TSV"

echo "🎉 Analysis complete. Production summary spreadsheet saved to: ../results/$SUMMARY_TSV"
